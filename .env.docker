# MCP Gateway Docker Environment Configuration
# This file is optimized for Docker Compose deployments

# ===================================
# Database Configuration
# ===================================
POSTGRES_DB=mcp_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-secure-password-here
POSTGRES_PORT=5432

# ===================================
# Backend Configuration
# ===================================
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_PORT=8000

# Database URL (uses postgres service name from docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:changeme-secure-password-here@postgres:5432/mcp_gateway

# ===================================
# Frontend Configuration
# ===================================
FRONTEND_PORT=3000

# ===================================
# Security
# ===================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=changeme-generate-secure-key-here

# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO

# ===================================
# MCP Settings
# ===================================
HEALTH_CHECK_INTERVAL=60
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_BACKOFF_BASE=2

# ===================================
# Server URLs (Docker internal)
# ===================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
BASE_URL=http://backend:8000
